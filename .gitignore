# macOS
.DS_Store

# Git worktrees created by tooling
.worktrees/

# Rust
/target/
**/*.rs.bk

# Node
node_modules/
*.log
.pnpm-debug.log*

# Frontend build output
apps/desktop/dist/

# Emitted beside the configs by a stray `tsc -b`: tsconfig.node.json is composite and
# includes vite.config.ts, so it writes JavaScript, declarations and a build stamp there.
# `pnpm typecheck` never does (tsconfig.json is noEmit), but one `tsc -b` leaves all three
# where the next `git add -A` would take them.
apps/desktop/vite.config.js
apps/desktop/vite.config.d.ts
apps/desktop/*.tsbuildinfo

# Tauri generated files
apps/desktop/src-tauri/gen/
apps/desktop/src-tauri/target/

# Test artifacts
apps/desktop/coverage/
apps/desktop/playwright-report/
apps/desktop/test-results/
apps/desktop/blob-report/

# Editors
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# Local environment files (.env.mock is committed on purpose)
.env
.env.local
.env.*.local
